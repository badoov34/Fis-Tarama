# ============================================================================
# Fiş Tarama — Ortam Değişkenleri
# ============================================================================
# Bu dosyayı .env olarak kopyalayın ve değerleri düzenleyin:
#   cp .env.example .env

# Veritabanı (PostgreSQL)
DATABASE_URL=postgresql://fis_user:fis_sifre@localhost:5432/fis_tarama

# JWT (zorunlu — mutlaka değiştirin!)
JWT_SECRET=buraya-cok-guclu-bir-sifre-yazin
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=365

# Sunucu
HOST=0.0.0.0
PORT=8000
DEBUG=false

# OCR
TESSERACT_LANG=tur
GEMINI_API_KEY=

# Yükleme
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# Ortam
ENVIRONMENT=development
