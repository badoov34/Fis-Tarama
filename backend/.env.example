# === VERİTABANI ===
# Lokal geliştirme için:
DATABASE_URL=postgresql://fis_user:fis_sifre@localhost:5432/fis_tarama
# Render için: Render otomatik doldurur (DATABASE_URL environment variable)

# === JWT GÜVENLİK ===
JWT_SECRET=buraya-guclu-bir-sifre-yazin-degisin
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=365

# === SUNUCU ===
HOST=0.0.0.0
PORT=8000
DEBUG=false

# === OCR ===
# Tesseract dil paketi (Türkçe)
TESSERACT_LANG=tur

# === YÜKLEME ===
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# === ORTAM ===
ENVIRONMENT=development
